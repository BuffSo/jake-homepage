{
  "name": "jake-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:sensitive": "node scripts/check-sensitive.mjs --all",
    "check:units": "node scripts/check-units.mjs --all",
    "check:motion-size": "node scripts/check-motion-size.mjs",
    "check:stack": "node scripts/check-stack.mjs",
    "sync": "node scripts/sync-content.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "next build && playwright test",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
